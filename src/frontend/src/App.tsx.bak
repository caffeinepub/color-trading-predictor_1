// ─── Hack mode CSS animations ─────────────────────────────────────────────────
const HACK_STYLES = `
  @keyframes glitch {
    0%   { text-shadow: 0 0 8px #00FF41, 2px 0 #00FF41, -2px 0 #00FFFF; }
    20%  { text-shadow: 0 0 8px #00FF41, -2px 0 #00FF41, 2px 0 #00FFFF; }
    40%  { text-shadow: 0 0 12px #00FF41, 3px 1px #00FF41, -3px -1px #00FFFF; }
    60%  { text-shadow: 0 0 8px #00FF41, -1px 0 #00FF41, 1px 0 #00FFFF; }
    80%  { text-shadow: 0 0 14px #00FF41, 2px -1px #00FF41, -2px 1px #00FFFF; }
    100% { text-shadow: 0 0 8px #00FF41, 2px 0 #00FF41, -2px 0 #00FFFF; }
  }
  @keyframes neon-pulse {
    0%   { box-shadow: 0 0 12px #00FF41, 0 0 24px #00FF4180, inset 0 0 12px #00FF4115; }
    50%  { box-shadow: 0 0 24px #00FF41, 0 0 48px #00FF4180, 0 0 80px #00FF4140, inset 0 0 20px #00FF4120; }
    100% { box-shadow: 0 0 12px #00FF41, 0 0 24px #00FF4180, inset 0 0 12px #00FF4115; }
  }
  @keyframes matrix-text {
    0%   { color: #00FF41; text-shadow: 0 0 8px #00FF41; }
    33%  { color: #00FFFF; text-shadow: 0 0 8px #00FFFF; }
    66%  { color: #39FF14; text-shadow: 0 0 8px #39FF14; }
    100% { color: #00FF41; text-shadow: 0 0 8px #00FF41; }
  }
  @keyframes hack-badge-pulse {
    0%   { opacity: 1; }
    50%  { opacity: 0.55; }
    100% { opacity: 1; }
  }
  .hack-glitch-title {
    animation: glitch 1.8s infinite;
  }
  .hack-neon-border {
    animation: neon-pulse 2s ease-in-out infinite;
    border: 1px solid #00FF41 !important;
  }
  .matrix-text-anim {
    animation: matrix-text 2s infinite;
  }
  .hack-badge-pulse {
    animation: hack-badge-pulse 1.2s ease-in-out infinite;
  }
`;

