// ─── Profit color helper ───────────────────────────────────────────────────────
function getProfitColor(multiplier: number): {
  color: string;
  glow: string;
} {
  if (multiplier >= 1.8) {
    return { color: "#33E06F", glow: "0 0 20px #33E06F80, 0 0 40px #33E06F40" };
  }
  if (multiplier >= 1.4) {
    return {
      color: "oklch(0.75 0.14 85)",
      glow: "0 0 20px oklch(0.75 0.14 85 / 0.5), 0 0 40px oklch(0.75 0.14 85 / 0.3)",
    };
  }
  return { color: "#E04646", glow: "0 0 20px #E0464680, 0 0 40px #E0464640" };
}

function getHackProfitColor(): { color: string; glow: string } {
  return { color: "#00FF41", glow: "0 0 20px #00FF4180, 0 0 40px #00FF4140" };
}

