// ─── Valid gift codes ─────────────────────────────────────────────────────────
const VALID_CODES = new Set(["VIP2024", "LUCKY6", "PROFIT99"]);

const SIGNAL_BARS = [40, 65, 85, 100];

function formatTime(ts: bigint): string {
  const ms = Number(ts) / 1_000_000;
  return new Date(ms).toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  });
}

function getProfit(n: number): string {
  return n <= 4
    ? (1.5 + n * 0.1).toFixed(2)
    : (1.2 + (n - 5) * 0.12).toFixed(2);
}

function getHackProfit(n: number): string {
  // Hack mode: boosted 2.5x – 9.9x based on number
  const base = 2.5 + (n / 9) * 7.4;
  const jitter = (Math.sin(n * 137.508) * 0.5 + 0.5) * 0.8;
  return Math.min(9.9, base + jitter).toFixed(2);
}

// ─── WinLossStats ─────────────────────────────────────────────────────────────
type WinLossMap = Record<number, "win" | "loss">;

function computeStreak(map: WinLossMap, total: number): string {
  if (total === 0) return "—";
  let count = 0;
  let kind: "win" | "loss" | null = null;
  for (let i = 0; i < total; i++) {
    const v = map[i];
    if (!v) break;
    if (kind === null) kind = v;
    if (v === kind) count++;
    else break;
  }
  if (!kind || count === 0) return "—";
  return `${count}${kind === "win" ? "W" : "L"}`;
}

function WinLossStats({
  map,
  total,
}: {
  map: WinLossMap;
  total: number;
}) {
  const wins = Object.values(map).filter((v) => v === "win").length;
  const losses = Object.values(map).filter((v) => v === "loss").length;
  const marked = wins + losses;
  const winRate = marked > 0 ? Math.round((wins / marked) * 100) : null;
  const streak = computeStreak(map, total);
  const isWinStreak = streak.endsWith("W");

  const stats = [
    {
      label: "Marked",
      value: String(marked),
      color: "oklch(0.75 0.14 85)",
      glow: "oklch(0.75 0.14 85 / 0.35)",
    },
    {
      label: "Wins",
      value: String(wins),
      color: "oklch(0.72 0.21 145)",
      glow: "oklch(0.72 0.21 145 / 0.35)",
    },
    {
      label: "Losses",
      value: String(losses),
      color: "oklch(0.62 0.22 25)",
      glow: "oklch(0.62 0.22 25 / 0.35)",
    },
    {
      label: "Win Rate",
      value: winRate !== null ? `${winRate}%` : "—",
      color: "oklch(0.85 0.12 88)",
      glow: "oklch(0.75 0.14 85 / 0.3)",
    },
    {
      label: "Streak",
      value: streak,
      color: isWinStreak
        ? "oklch(0.72 0.21 145)"
        : streak === "—"
          ? "oklch(0.55 0.01 240)"
          : "oklch(0.62 0.22 25)",
      glow: isWinStreak
        ? "oklch(0.72 0.21 145 / 0.35)"
        : "oklch(0.62 0.22 25 / 0.25)",
    },
  ];

  return (
    <motion.section
      className="relative z-10 max-w-6xl mx-auto px-6 mb-10"
      initial={{ opacity: 0, y: 16 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.5, delay: 0.1 }}
      data-ocid="winloss.section"
    >
      <p className="text-center text-xs font-semibold tracking-[0.3em] text-muted-foreground mb-5 uppercase">
        Win / Loss Tracker
      </p>
      <div
        className="rounded-2xl p-5"
        style={{
          background:
            "linear-gradient(145deg, oklch(0.15 0.010 230), oklch(0.13 0.008 235))",
          border: "1px solid oklch(0.75 0.14 85 / 0.20)",
          boxShadow: "0 0 40px oklch(0 0 0 / 0.35)",
        }}
      >
        <div className="grid grid-cols-2 sm:grid-cols-5 gap-4">
          {stats.map((s) => (
            <div
              key={s.label}
              className="flex flex-col items-center gap-1.5 py-3 px-2 rounded-xl"
              style={{
                background: "oklch(0.12 0.006 240 / 0.7)",
                border: `1px solid ${s.color}40`,
                boxShadow: `0 0 16px ${s.glow}`,
              }}
            >
              <span
                className="font-display font-bold text-2xl tracking-wider leading-none"
                style={{ color: s.color, textShadow: `0 0 14px ${s.glow}` }}
              >
                {s.value}
              </span>
              <span className="text-xs font-semibold tracking-[0.18em] uppercase text-muted-foreground">
                {s.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </motion.section>
  );
}

