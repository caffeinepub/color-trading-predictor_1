// ─── Gift Code Panel ──────────────────────────────────────────────────────────
function GiftCodePanel() {
  const [code, setCode] = useState("");
  const [bonusActive, setBonusActive] = useState(false);

  const handleRedeem = () => {
    if (VALID_CODES.has(code.trim().toUpperCase())) {
      setBonusActive(true);
      toast.success("Gift code redeemed! Bonus activated.");
    } else {
      toast.error("Invalid code. Try VIP2024, LUCKY6, or PROFIT99.");
    }
  };

  return (
    <motion.section
      className="relative z-10 max-w-6xl mx-auto px-6 mb-10"
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.5, delay: 0.2 }}
      data-ocid="giftcode.section"
    >
      <p className="text-center text-xs font-semibold tracking-[0.4em] text-muted-foreground mb-5 uppercase">
        🎁 Gift Code
      </p>
      <div
        className="rounded-2xl p-6"
        style={{
          background:
            "linear-gradient(145deg, oklch(0.15 0.010 230), oklch(0.13 0.008 235))",
          border: "1px solid oklch(0.75 0.14 85 / 0.20)",
          boxShadow: "0 0 40px oklch(0 0 0 / 0.35)",
        }}
      >
        <div className="flex flex-col sm:flex-row items-center gap-4 justify-center">
          <div className="relative flex-1 max-w-sm w-full">
            <Gift
              className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4"
              style={{ color: "oklch(0.75 0.14 85 / 0.6)" }}
            />
            <Input
              className="pl-9 font-mono tracking-widest uppercase"
              placeholder="Enter gift code..."
              value={code}
              onChange={(e) => setCode(e.target.value.toUpperCase())}
              onKeyDown={(e) => e.key === "Enter" && handleRedeem()}
              style={{
                background: "oklch(0.12 0.006 240 / 0.8)",
                border: "1px solid oklch(0.75 0.14 85 / 0.25)",
                color: "oklch(0.85 0.12 88)",
              }}
              data-ocid="giftcode.input"
            />
          </div>
          <Button
            onClick={handleRedeem}
            className="font-display font-bold tracking-widest uppercase px-8"
            style={{
              background:
                "linear-gradient(135deg, oklch(0.62 0.13 82), oklch(0.85 0.12 88))",
              color: "oklch(0.12 0.006 240)",
              boxShadow: "0 0 20px oklch(0.75 0.14 85 / 0.35)",
              border: "none",
            }}
            data-ocid="giftcode.submit_button"
          >
            REDEEM
          </Button>
        </div>

        <AnimatePresence>
          {bonusActive && (
            <motion.div
              className="flex justify-center mt-5"
              initial={{ opacity: 0, scale: 0.6, y: 10 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.6 }}
              transition={{ type: "spring", stiffness: 280, damping: 20 }}
            >
              <Badge
                className="px-6 py-2 text-sm font-display font-bold tracking-[0.25em] uppercase rounded-full"
                style={{
                  background: "oklch(0.75 0.14 85 / 0.15)",
                  border: "1px solid oklch(0.75 0.14 85)",
                  color: "oklch(0.85 0.12 88)",
                  boxShadow:
                    "0 0 20px oklch(0.75 0.14 85 / 0.5), 0 0 50px oklch(0.75 0.14 85 / 0.25)",
                }}
                data-ocid="giftcode.success_state"
              >
                ✦ BONUS ACTIVE
              </Badge>
            </motion.div>
          )}
        </AnimatePresence>

        <p className="text-center text-xs text-muted-foreground mt-4">
          Try: <span className="font-mono opacity-60">VIP2024</span> •{" "}
          <span className="font-mono opacity-60">LUCKY6</span> •{" "}
          <span className="font-mono opacity-60">PROFIT99</span>
        </p>
      </div>
    </motion.section>
  );
}

// ─── MatrixRain canvas ────────────────────────────────────────────────────────
function MatrixRain() {
  const canvasRef = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const CHARS =
      "アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    const FONT_SIZE = 14;

    canvas.width = window.innerWidth;
    let width = window.innerWidth;
    canvas.height = window.innerHeight;
    let height = window.innerHeight;
    let cols = Math.floor(width / FONT_SIZE);
    let drops = Array.from({ length: cols }, () =>
      Math.floor(Math.random() * (height / FONT_SIZE)),
    );

    const handleResize = () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      cols = Math.floor(width / FONT_SIZE);
      drops = Array.from({ length: cols }, () =>
        Math.floor(Math.random() * (height / FONT_SIZE)),
      );
    };
    window.addEventListener("resize", handleResize);

    let rafId: number;

    const draw = () => {
      ctx.fillStyle = "rgba(0, 0, 0, 0.05)";
      ctx.fillRect(0, 0, width, height);

      ctx.font = `${FONT_SIZE}px monospace`;

      for (let i = 0; i < drops.length; i++) {
        const char = CHARS[Math.floor(Math.random() * CHARS.length)];
        const x = i * FONT_SIZE;
        const y = drops[i] * FONT_SIZE;

        // Leading character brighter
        const brightness = Math.random() > 0.95 ? 255 : 0;
        ctx.fillStyle =
          brightness === 255
            ? "#AFFFB5"
            : `rgba(0, 255, 65, ${0.4 + Math.random() * 0.6})`;
        ctx.fillText(char, x, y);

        if (y > height && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i]++;
      }

      rafId = requestAnimationFrame(draw);
    };

    rafId = requestAnimationFrame(draw);

    return () => {
      cancelAnimationFrame(rafId);
      window.removeEventListener("resize", handleResize);
    };
  }, []);

  return (
    <canvas
      ref={canvasRef}
      style={{
        position: "fixed",
        top: 0,
        left: 0,
        width: "100vw",
        height: "100vh",
        zIndex: 0,
        pointerEvents: "none",
        opacity: 0.6,
      }}
    />
  );
}

